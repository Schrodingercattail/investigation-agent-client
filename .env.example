# Investigation Agent Client — Compose configuration example.
# Copy to .env in the repository root and fill in the values:
#   cp .env.example .env
#
# ── Demo vs External RP modes ─────────────────────────────────────
# By default (AGENT_SYNTHETIC_RP_FIXTURE unset) the stack runs in DEMO
# mode: the backend serves a bundled synthetic case (U99001) so you can
# try the full Agent experience WITHOUT deploying a Risk Platform.
# Demo data is fully synthetic — it is NOT real Risk Platform evidence.
#
# To connect your OWN Risk Platform instead (External RP mode), set
# BOTH of the following in this .env:
#   AGENT_SYNTHETIC_RP_FIXTURE=      (explicitly EMPTY — disables Demo)
#   RISK_PLATFORM_BASE_URL=<your Risk Platform URL>
# Caution: shell-exported variables override this .env file. If your
# shell exports ANTHROPIC_BASE_URL or AGENT_SYNTHETIC_RP_FIXTURE, clear
# them or the .env values will not apply.

# ── External RP mode ──────────────────────────────────────────────
# External Risk Platform (required in External RP mode; ignored in Demo)
RISK_PLATFORM_BASE_URL=http://host.docker.internal:8000

# ── LLM configuration (required for real investigation turns) ────
# ANTHROPIC_API_KEY must be filled in by the user — no real key is
# provided, and it must never be committed. Without a key the stack
# starts and runs in deterministic fallback mode (investigation answers
# are produced without real LLM reasoning).
ANTHROPIC_API_KEY=
# Default endpoint = Zhipu GLM's Anthropic-compatible API (matches glm-5.3
# below). If you switch model providers, replace it with that provider's
# Anthropic-compatible API endpoint.
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_MODEL=glm-5.3
