# Investigation Agent Client — Compose configuration example.
# Copy to .env in the repository root and fill in the values:
#   cp .env.example .env
#
# The Risk Platform is an EXTERNAL dependency: start it first and point
# RISK_PLATFORM_BASE_URL at it. From inside Docker, use
# http://host.docker.internal:8000 to reach a Risk Platform running on the
# host's port 8000.

# External Risk Platform (required)
RISK_PLATFORM_BASE_URL=http://host.docker.internal:8000

# LLM used by the planner (required for investigation turns)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=glm-5.3
